{
  "name": "zaldo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "test": "tsx --test test/zaldo.test.ts test/admin.test.ts test/landing.test.ts test/caja.test.ts test/versatil.test.ts test/cuenta.test.ts test/montos.test.ts test/reglas.test.ts test/dicho.test.ts test/puente.test.ts test/flujos.test.ts test/candados.test.ts test/botones.test.ts test/memoria.test.ts",
    "admin:hash": "tsx scripts/hash-password.ts",
    "zaldo:publish": "tsx scripts/publish-core.ts",
    "zaldo:status": "tsx scripts/publish-core.ts --status",
    "zaldo:rollback": "tsx scripts/publish-core.ts --rollback",
    "pey:test-account": "tsx scripts/pey-test-account.ts",
    "landing:publish": "tsx scripts/publish-landing.ts",
    "landing:watch": "tsx scripts/publish-landing.ts --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "openai": "^4.77.0",
    "qrcode": "^1.5.4",
    "standardwebhooks": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
