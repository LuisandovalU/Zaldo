PORT=3000

# OpenRouter. El modelo tiene que saber usar tools.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_TRANSCRIBE_MODEL=openai/whisper-large-v3

# Pey. La key de prueba mientras Banxico activa la cuenta (5 días).
PEY_API_KEY=
PEY_WEBHOOK_SECRET=
PEY_API_BASE=https://api.pey.mx
# La llave tiene que tener una cuenta CoDi activa. Mientras Banxico activa la
# tuya, pey da una cuenta de pruebas: npm run pey:test-account te da su id.
# Con ella el dinero NO llega a tu banco ni se devuelve: deja el tope en 1 peso.
# Cuando tu cuenta quede activa, borra las dos líneas.
PEY_BANK_ACCOUNT_ID=
PEY_TEST_MAX_MXN=

# WhatsApp Cloud API. El verify token lo inventas tú y lo pegas igual en Meta.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=zaldo

# Celulares del dueño, separados por coma. Vacío = acepta a quien escriba
# (sirve en el número de prueba de Meta). Compara los últimos 10 dígitos.
ALLOWED_PHONES=

# Tope de cobros confirmados por día, en pesos.
DAILY_CAP_MXN=5000

# URL pública https del túnel. Hace falta para el link de pago.
PUBLIC_BASE_URL=

DATA_PATH=./data/zaldo.json

# --- Panel administrador (/admin) ---
# Genera usuario y hash con: npm run admin:hash -- <usuario>
# Varios admins van separados por comas.
ADMIN_USERS=
# Al menos 32 caracteres. El script de arriba te da uno.
ADMIN_SESSION_SECRET=
ADMIN_SESSION_HOURS=8
ADMIN_MAX_ATTEMPTS=5
ADMIN_LOCKOUT_MINUTES=15
# Pon false solo para probar en http://localhost. En producción, déjalo en true.
ADMIN_COOKIE_SECURE=true
# En un PaaS con proxy (ih0st, Railway) ponlo en true para que el límite de
# intentos cuente la IP real del visitante y no la del proxy.
ADMIN_TRUST_PROXY=false

# --- Landing en zaldo.ih0st.app sin push ---
# npm run landing:publish (una vez) o npm run landing:watch (cada que guardas).
# El mismo valor va en el entorno del servidor de ih0st.app (ZALDO_PUBLISH_TOKEN).
ZALDO_PUBLISH_TOKEN=
# ZALDO_PUBLISH_URL=https://zaldo.ih0st.app/zaldo/site
